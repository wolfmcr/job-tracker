rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Membership is the only way in. Members are added and removed by scripts/admin.mjs (the Admin
    // SDK, which these rules don't apply to); the app can never write it.
    function isMember(bizId) {
      return signedIn() && exists(/databases/$(database)/documents/businesses/$(bizId)/members/$(request.auth.uid));
    }

    function data() {
      return request.resource.data;
    }

    // New documents: only known fields, the required ones present, created "now" (serverTimestamp)
    function isValidCreate(allowed, required) {
      return data().keys().hasOnly(allowed)
        && data().keys().hasAll(required)
        && data().createdAt == request.time;
    }

    // Edits may only touch these fields; anything else on the document (older fields) is left alone
    function onlyChanges(allowed) {
      return data().diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function optionalText(field, max) {
      return !(field in data()) || isText(data()[field], 0, max);
    }

    function optionalPriority() {
      return !('priority' in data()) || (data().priority is int && data().priority >= 0 && data().priority <= 2);
    }

    function isISODate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Which business an account belongs to (one each), so the app knows where to look.
    // Only its own account can read it; only scripts/admin.mjs writes it.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Everything a business has lives under its document, so the path alone decides who gets in
    match /businesses/{bizId} {
      // Members read it for the business's name
      allow read: if isMember(bizId);

      // A task or shopping item must name a job of this same business
      function isJobHere(jobId) {
        return jobId is string && exists(/databases/$(database)/documents/businesses/$(bizId)/jobs/$(jobId));
      }

      match /jobs/{jobId} {
        function isValidJob() {
          return isText(data().name, 1, 200)
            && isText(data().address, 0, 500)
            && optionalText('color', 20)
            && optionalText('clientName', 200)
            && optionalText('clientPhone', 50)
            && optionalText('notes', 10000)
            && data().isDone is bool
            && data().isArchived is bool
            && data().updatedAt == request.time;
        }

        allow read: if isMember(bizId);
        allow create: if isMember(bizId) && isValidJob() && isValidCreate(
          ['name', 'address', 'color', 'clientName', 'clientPhone', 'notes', 'isDone', 'isArchived', 'createdAt', 'updatedAt'],
          ['name', 'address', 'isDone', 'isArchived', 'createdAt', 'updatedAt']);
        allow update: if isMember(bizId) && isValidJob()
          && onlyChanges(['name', 'address', 'color', 'clientName', 'clientPhone', 'notes', 'isDone', 'isArchived', 'updatedAt']);
        // The app archives jobs rather than deleting them
        allow delete: if false;
      }

      // The job's id is a field (not the path), so the Shopping tab can list the whole business's items
      match /shoppingItems/{itemId} {
        function isValidItem() {
          return isText(data().qty, 0, 50)
            && isText(data().name, 1, 200)
            && optionalText('taskId', 100)
            && data().isGot is bool
            && optionalPriority();
        }

        allow read, delete: if isMember(bizId);
        allow create: if isMember(bizId) && isValidItem() && isJobHere(data().jobId) && isValidCreate(
          ['jobId', 'qty', 'name', 'taskId', 'isGot', 'priority', 'createdAt'],
          ['jobId', 'qty', 'name', 'isGot', 'createdAt']);
        // jobId isn't in the list, so an item can't be moved to another job
        allow update: if isMember(bizId) && isValidItem()
          && onlyChanges(['qty', 'name', 'taskId', 'isGot', 'priority']);
      }

      match /tasks/{taskId} {
        function isValidTask() {
          return isText(data().text, 1, 500)
            && (!('bullets' in data()) || (data().bullets is list && data().bullets.size() <= 100))
            && data().isDone is bool
            && (!('completedAt' in data()) || data().completedAt is timestamp)
            && (!('dueDate' in data()) || isISODate(data().dueDate))
            && optionalPriority();
        }

        allow read, delete: if isMember(bizId);
        allow create: if isMember(bizId) && isValidTask() && isJobHere(data().jobId) && isValidCreate(
          ['jobId', 'text', 'bullets', 'isDone', 'completedAt', 'dueDate', 'priority', 'createdAt'],
          ['jobId', 'text', 'isDone', 'createdAt']);
        allow update: if isMember(bizId) && isValidTask()
          && onlyChanges(['text', 'bullets', 'isDone', 'completedAt', 'dueDate', 'priority']);
      }

      match /employees/{employeeId} {
        function isValidEmployee() {
          return isText(data().name, 1, 200)
            && data().hourlyRate is number && data().hourlyRate >= 0 && data().hourlyRate <= 10000
            && (!('timer' in data()) || isValidTimer(data().timer));
        }

        // The Hours timer while a session is running or paused; removed when it's logged or discarded
        function isValidTimer(timer) {
          return timer is map
            && timer.keys().hasOnly(['startedAt', 'pausedAt', 'pausedMs'])
            && timer.keys().hasAll(['startedAt', 'pausedAt', 'pausedMs'])
            && timer.startedAt is timestamp && timer.startedAt <= request.time + duration.value(5, 'm')
            && (timer.pausedAt == null || timer.pausedAt is timestamp)
            && timer.pausedMs is number && timer.pausedMs >= 0;
        }

        allow read: if isMember(bizId);
        allow create: if isMember(bizId) && isValidEmployee()
          && isValidCreate(['name', 'hourlyRate', 'createdAt'], ['name', 'hourlyRate', 'createdAt']);
        allow update: if isMember(bizId) && isValidEmployee() && onlyChanges(['name', 'hourlyRate', 'timer']);
        allow delete: if false;

        match /timeEntries/{entryId} {
          function isValidEntry() {
            return isISODate(data().date)
              && data().hours is number && data().hours > 0 && data().hours <= 1000
              && data().rate is number && data().rate >= 0
              && isText(data().note, 0, 1000);
          }

          allow read, delete: if isMember(bizId);
          allow create: if isMember(bizId) && isValidEntry()
            && isValidCreate(['date', 'hours', 'rate', 'note', 'createdAt'], ['date', 'hours', 'rate', 'note', 'createdAt']);
          // The rate stays as logged so later rate changes don't rewrite history
          allow update: if isMember(bizId) && isValidEntry() && onlyChanges(['date', 'hours', 'note']);
        }

        match /payments/{paymentId} {
          function isValidPayment() {
            return isISODate(data().date)
              && data().amount is number && data().amount > 0 && data().amount <= 1000000
              && isText(data().note, 0, 1000);
          }

          allow read, delete: if isMember(bizId);
          allow create: if isMember(bizId) && isValidPayment()
            && isValidCreate(['date', 'amount', 'note', 'createdAt'], ['date', 'amount', 'note', 'createdAt']);
          allow update: if isMember(bizId) && isValidPayment() && onlyChanges(['date', 'amount', 'note']);
        }
      }

      match /receipts/{receiptId} {
        // Saved as printed; anything worked out from it (like each job's share of tax) is done in the app
        function isMoney(value) {
          return value is number && value >= -1000000 && value <= 1000000;
        }

        function isValidReceipt() {
          return isText(data().store, 1, 200)
            && isISODate(data().date)
            && isMoney(data().tax)
            && isMoney(data().total)
            && data().items is list && data().items.size() <= 100
            && data().jobIds is list && data().jobIds.size() <= 100
            && isText(data().note, 0, 1000)
            && (!('photoPath' in data()) || data().photoPath == 'businesses/' + bizId + '/receipts/' + receiptId + '.jpg');
        }

        allow read, delete: if isMember(bizId);
        allow create: if isMember(bizId) && isValidReceipt() && isValidCreate(
          ['store', 'date', 'tax', 'total', 'items', 'jobIds', 'photoPath', 'note', 'createdAt'],
          ['store', 'date', 'tax', 'total', 'items', 'jobIds', 'note', 'createdAt']);
        allow update: if isMember(bizId) && isValidReceipt()
          && onlyChanges(['store', 'date', 'tax', 'total', 'items', 'jobIds', 'photoPath', 'note']);
      }
    }
  }
}
