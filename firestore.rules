rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;

      match /shoppingItems/{itemId} {
        allow read, write: if request.auth != null;
      }

      match /tasks/{taskId} {
        allow read, write: if request.auth != null;
      }
    }

    // Employees and their timeEntries/payments subcollections
    match /employees/{path=**} {
      allow read, write: if request.auth != null;
    }

    // Required for collectionGroup queries across all jobs
    match /{path=**}/shoppingItems/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /{path=**}/tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
  }
}
