rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts allowed to use the app. Add a user's UID here to give them access.
    function isAllowed() {
      return request.auth != null && request.auth.uid in [
        'Eim2A7s7g7Rntq7X2oWd3jRdMbg1',
      ];
    }

    function data() {
      return request.resource.data;
    }

    // New documents: only known fields, the required ones present, created "now" (serverTimestamp)
    function isValidCreate(allowed, required) {
      return data().keys().hasOnly(allowed)
        && data().keys().hasAll(required)
        && data().createdAt == request.time;
    }

    // Edits may only touch these fields; anything else on the document (older fields) is left alone
    function onlyChanges(allowed) {
      return data().diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function optionalText(field, max) {
      return !(field in data()) || isText(data()[field], 0, max);
    }

    function optionalPriority() {
      return !('priority' in data()) || (data().priority is int && data().priority >= 0 && data().priority <= 2);
    }

    function isISODate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /jobs/{jobId} {
      function isValidJob() {
        return isText(data().name, 1, 200)
          && isText(data().address, 0, 500)
          && optionalText('color', 20)
          && optionalText('clientName', 200)
          && optionalText('clientPhone', 50)
          && optionalText('notes', 10000)
          && data().isDone is bool
          && data().isArchived is bool
          && data().updatedAt == request.time;
      }

      allow read: if isAllowed();
      allow create: if isAllowed() && isValidJob() && isValidCreate(
        ['name', 'address', 'color', 'clientName', 'clientPhone', 'notes', 'isDone', 'isArchived', 'createdAt', 'updatedAt'],
        ['name', 'address', 'isDone', 'isArchived', 'createdAt', 'updatedAt']);
      allow update: if isAllowed() && isValidJob()
        && onlyChanges(['name', 'address', 'color', 'clientName', 'clientPhone', 'notes', 'isDone', 'isArchived', 'updatedAt']);
      // The app archives jobs rather than deleting them
      allow delete: if false;

      match /shoppingItems/{itemId} {
        function isValidItem() {
          return isText(data().qty, 0, 50)
            && isText(data().name, 1, 200)
            && optionalText('taskId', 100)
            && data().isGot is bool
            && optionalPriority();
        }

        allow read, delete: if isAllowed();
        allow create: if isAllowed() && isValidItem() && isValidCreate(
          ['qty', 'name', 'taskId', 'isGot', 'priority', 'createdAt'],
          ['qty', 'name', 'isGot', 'createdAt']);
        allow update: if isAllowed() && isValidItem()
          && onlyChanges(['qty', 'name', 'taskId', 'isGot', 'priority']);
      }

      match /tasks/{taskId} {
        function isValidTask() {
          return isText(data().text, 1, 500)
            && (!('bullets' in data()) || (data().bullets is list && data().bullets.size() <= 100))
            && data().isDone is bool
            && (!('completedAt' in data()) || data().completedAt is timestamp)
            && (!('dueDate' in data()) || isISODate(data().dueDate))
            && optionalPriority();
        }

        allow read, delete: if isAllowed();
        allow create: if isAllowed() && isValidTask() && isValidCreate(
          ['text', 'bullets', 'isDone', 'completedAt', 'dueDate', 'priority', 'createdAt'],
          ['text', 'isDone', 'createdAt']);
        allow update: if isAllowed() && isValidTask()
          && onlyChanges(['text', 'bullets', 'isDone', 'completedAt', 'dueDate', 'priority']);
      }
    }

    match /employees/{employeeId} {
      function isValidEmployee() {
        return isText(data().name, 1, 200)
          && data().hourlyRate is number && data().hourlyRate >= 0 && data().hourlyRate <= 10000;
      }

      allow read: if isAllowed();
      allow create: if isAllowed() && isValidEmployee()
        && isValidCreate(['name', 'hourlyRate', 'createdAt'], ['name', 'hourlyRate', 'createdAt']);
      allow update: if isAllowed() && isValidEmployee() && onlyChanges(['name', 'hourlyRate']);
      allow delete: if false;

      match /timeEntries/{entryId} {
        function isValidEntry() {
          return isISODate(data().date)
            && data().hours is number && data().hours > 0 && data().hours <= 1000
            && data().rate is number && data().rate >= 0
            && isText(data().note, 0, 1000);
        }

        allow read, delete: if isAllowed();
        allow create: if isAllowed() && isValidEntry()
          && isValidCreate(['date', 'hours', 'rate', 'note', 'createdAt'], ['date', 'hours', 'rate', 'note', 'createdAt']);
        // The rate stays as logged so later rate changes don't rewrite history
        allow update: if isAllowed() && isValidEntry() && onlyChanges(['date', 'hours', 'note']);
      }

      match /payments/{paymentId} {
        function isValidPayment() {
          return isISODate(data().date)
            && data().amount is number && data().amount > 0 && data().amount <= 1000000
            && isText(data().note, 0, 1000);
        }

        allow read, delete: if isAllowed();
        allow create: if isAllowed() && isValidPayment()
          && isValidCreate(['date', 'amount', 'note', 'createdAt'], ['date', 'amount', 'note', 'createdAt']);
        allow update: if isAllowed() && isValidPayment() && onlyChanges(['date', 'amount', 'note']);
      }
    }

    // Collection-group queries for the Shopping and Tasks tabs. Read only: a write rule here
    // would bypass the validation above, since any matching rule allows the request.
    match /{path=**}/shoppingItems/{itemId} {
      allow read: if isAllowed();
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isAllowed();
    }
  }
}
